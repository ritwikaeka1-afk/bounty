NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=https://joinbounty.dev
# Optional but strongly recommended during beta. Configure the matching secret
# in Supabase Auth > Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Native app links. Add these only after your Apple team and Android signing
# certificate exist; the .well-known endpoints stay unavailable until then.
APPLE_APP_TEAM_ID=
APPLE_BUNDLE_ID=dev.joinbounty.app
ANDROID_APP_LINK_PACKAGE_NAME=dev.joinbounty.app
# Comma-separate the upload and Google Play App Signing SHA-256 fingerprints
# when you test both installation paths.
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=
# Optional client analytics: authenticated event names only, disabled by default.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Optional push; public key must also be supplied at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Runtime-only secrets. Never prefix these with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_JOB_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Resend for task/status emails; separate from Supabase Auth SMTP. Runtime only.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

